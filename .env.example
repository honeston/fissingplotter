# AWS リージョン
VITE_AWS_REGION=ap-northeast-1

# SAM デプロイ後の Outputs から設定（infra/template.yaml）
VITE_API_URL=https://xxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 未設定の場合はローカル専用モード（IndexedDB のみ、ログイン不要）
