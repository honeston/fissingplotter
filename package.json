{
  "name": "fissingplotter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:stack:down": "docker compose down",
    "local:init": "node scripts/local-init.mjs",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=fissingplotter",
    "check:infra": "node scripts/check-infra.mjs",
    "build:fish-species": "python3 scripts/build_fish_species.py",
    "build:tide-stations": "node scripts/build_tide_stations.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.14",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.750.0",
    "@aws-sdk/client-cloudfront": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.119.0"
  }
}
