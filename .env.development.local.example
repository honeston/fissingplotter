# ローカル開発（npm run dev）専用。本番 URL はここに書かない。
# コピー: cp .env.development.local.example .env.development.local

VITE_AWS_REGION=ap-northeast-1
VITE_API_URL=http://127.0.0.1:3000

# 認証用 Cognito（ローカル専用 User Pool を推奨。未設定ならログイン不可）
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# sam local 用（scripts/dev-api.mjs が infra/env.local.json に反映）
OPENWEATHER_API_KEY=
# 海しる API: https://portal.msil.go.jp/howtouse （試用キー or 個別発行）
MSIL_SUBSCRIPTION_KEY=

# ローカルで GPS が使えない PC 向け（省略時: 横浜新港 35.45, 139.65）
# VITE_DEV_LAT=35.45
# VITE_DEV_LNG=139.65
